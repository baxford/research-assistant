{
  "manifest_version": 3,
  "name": "Researcher",
  "version": "1.0.0",
  "description": "Save web pages to your local research assistant",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Save to Researcher"
  },
  "content_scripts": [],
  "host_permissions": ["http://localhost:3001/*"]
}
